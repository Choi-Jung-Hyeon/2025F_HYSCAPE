# ===================================================================
# Hyscape Daily Automation - Environment Variables Template
# ===================================================================
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to version control - it contains secrets
# ===================================================================

# ===== Google Gemini AI =====
# Get your API key from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ===== Gmail SMTP =====
# Use an app password from: https://myaccount.google.com/apppasswords
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password_here

# ===== Notion API =====
# Get your integration token from: https://www.notion.so/my-integrations
# Database ID can be found in your Notion database URL
NOTION_API_TOKEN=your_notion_api_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# ===================================================================
# Setup Instructions:
# ===================================================================
# 1. Copy this file: cp .env.template .env
# 2. Edit .env and replace all placeholder values with your actual credentials
# 3. Never commit .env to git (.gitignore already excludes it)
# 4. For production deployment, ensure .env is properly configured on the server
# ===================================================================
